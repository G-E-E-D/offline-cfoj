{
  "name": "offline-cfoj",
  "version": "1.0.0",
  "description": "Local Codeforces practice judge and virtual contest platform for Windows (GNU C++23)",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sandbox": "go -C sandbox build -o ../bin/cfoj-sandbox.exe .",
    "setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "start": "node ./src/server.mjs",
    "test:milestone1": "node ./scripts/test-milestone1.mjs",
    "test:providers": "node --test ./scripts/test-provider-translation.mjs",
    "test:testgen": "node --test ./scripts/test-python-testgen-and-regen.mjs",
    "test:import": "node ./scripts/test-contest-import-workflow.mjs",
    "test:acceptance": "node ./scripts/verify-acceptance.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
